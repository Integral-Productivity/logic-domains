{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Integral-Productivity/logic-domains/schema/logic-domain.schema.json",
  "title": "Logic Domain manifest",
  "description": "Draft 0.1. Describes one Logic Domain: its classes, the logical kind of each class, and the source record types each class may mirror. See docs/adr/0001 and 0002.",
  "type": "object",
  "required": [
    "name",
    "title",
    "version",
    "status",
    "description",
    "classes",
    "flying_logic"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "deprecated"
      ]
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "description": "The role that decides changes to this Logic Domain. Empty until named."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flying_logic": {
      "type": "object",
      "required": [
        "domain_name",
        "domain_file"
      ],
      "additionalProperties": false,
      "description": "The Flying Logic domain that carries these classes. The exported .xlogicd file is the source of class identity: its class UUIDs keep existing trees linked, so it is exported from Flying Logic, never generated.",
      "properties": {
        "domain_name": {
          "type": "string"
        },
        "domain_file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.xlogicd$",
          "description": "Path, relative to the Logic Domain folder, of the domain exported with Entity > Export Selected Domain."
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "uuid",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The class UUID from the Flying Logic domain file."
          },
          "kind": {
            "enum": [
              "effect",
              "action",
              "precondition",
              "obstacle",
              "indicator",
              "unassigned"
            ],
            "description": "The logical kind. 'unassigned' marks a gap that the owner must close before the status can be 'accepted'."
          },
          "role": {
            "type": "string",
            "description": "A finer role inside the kind, for example 'undesirable', 'observed' or 'commitment'."
          },
          "src_types": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([a-z]+:[A-Za-z]+|research|none)$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
